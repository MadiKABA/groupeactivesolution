    "jsonld": [
      "{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Qui est Active Solution Digital Service ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Active Solution Digital Service est une entreprise basée à Dakar, au Sénégal. Elle forme aux métiers du numérique, conçoit des solutions digitales sur mesure et accompagne la transformation digitale des organisations.\"}},{\"@type\":\"Question\",\"name\":\"Dans quels domaines intervenez-vous ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nous intervenons dans trois domaines : la formation et l'éducation numérique, le développement de solutions numériques et la transformation digitale des organisations.\"}},{\"@type\":\"Question\",\"name\":\"Quelles formations proposez-vous, et pour qui ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Programmation et développement web, robotique, électronique et systèmes embarqués, Internet des objets et intelligence artificielle, pour les établissements scolaires, les organisations et les apprenants.\"}},{\"@type\":\"Question\",\"name\":\"Quels types de solutions réalisez-vous ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sites web, applications web et mobiles, logiciels de gestion, plateformes métier, solutions SaaS et automatisation de processus.\"}},{\"@type\":\"Question\",\"name\":\"Comment se déroule un projet, de la première discussion à la livraison ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"En quatre étapes : comprendre votre besoin, définir la solution, la concevoir et la réaliser, puis vous accompagner et la faire évoluer.\"}},{\"@type\":\"Question\",\"name\":\"Que recouvre concrètement la transformation digitale ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"C'est l'accompagnement d'une organisation pour digitaliser ses processus, intégrer des outils numériques et former ses équipes à leur usage.\"}}]}"
    ],
