# Variables publiques (préfixe NEXT_PUBLIC_) : intégrées au code au moment du build.
# Changer une valeur sur Vercel demande un nouveau déploiement (Redeploy).
# Aucune variable secrète n'est nécessaire : le formulaire de contact ouvre WhatsApp ou la messagerie,
# et les coordonnées (WhatsApp, téléphone, e-mail) sont dans src/lib/site.ts.

# Placeholders et repères de contenu provisoire (« [À valider] », « Photo à fournir — … »).
# true : visibles (relecture du contenu). false ou absente : masqués (lancement officiel).
# En développement local (pnpm dev), ils sont toujours visibles.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# Indexation par les moteurs de recherche. Tout sauf "true" : noindex sur toutes les pages,
# robots.txt « Disallow: / », sitemap vide, en-tête X-Robots-Tag: noindex, nofollow.
# Passer à true seulement au lancement, sur le domaine officiel.
NEXT_PUBLIC_ALLOW_INDEXING=false

# URL publique du site, sans barre finale (canonical, Open Graph, JSON-LD, sitemap).
# Relecture : l'URL *.vercel.app du projet. Absente : https://www.groupactivesolution.com
NEXT_PUBLIC_SITE_URL=https://www.groupactivesolution.com
